{
  "name": "@onegrid/core",
  "version": "0.0.0",
  "description": "oneGrid core engine: canvas renderer, accessibility shadow DOM, signals, layout, selection.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/protocol": "workspace:*",
    "@onegrid/data": "workspace:*"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
