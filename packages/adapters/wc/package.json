{
  "name": "@onegrid/wc",
  "version": "0.0.0",
  "description": "Web Component adapter for oneGrid. Optional <one-grid> custom element wrapping the core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/core": "workspace:*",
    "@onegrid/protocol": "workspace:*"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
