{
  "name": "@onegrid/mysql",
  "version": "0.0.5",
  "description": "MySQL adapter for oneGrid SSRM. Translates BlockRequest into parameterized SQL; polling-based CDC stream against an outbox table.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/protocol": "workspace:*"
  },
  "peerDependencies": {
    "mysql2": "^3.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
