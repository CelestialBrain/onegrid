{
  "name": "@onegrid/vue",
  "version": "0.0.0",
  "description": "Vue 3 adapter for oneGrid. Idiomatic composables over the framework-agnostic core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@onegrid/core": "workspace:*",
    "@onegrid/protocol": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
