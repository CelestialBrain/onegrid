{
  "name": "@onegrid/benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright-based end-to-end + performance benchmark harness for oneGrid.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo test-results playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.0",
    "@types/node": "^22.0.0"
  }
}
